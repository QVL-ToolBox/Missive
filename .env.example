# Missive - configuration d'environnement (placeholders, jamais de secret reel commite)

# Serveur HTTP
PORT=8184
BIND_ADDR=127.0.0.1
# Opt-in explicite pour un bind non-loopback (ex 0.0.0.0). Absent ou != true : le service refuse
# de demarrer sur une adresse externe (fail-safe).
ALLOW_EXTERNAL_BIND=false

# Transport SMTP
# Dev local : pointer vers Mailpit (SMTP_HOST=localhost, SMTP_PORT=1025, sans user/password, sans TLS).
# SMTP_USER + SMTP_PASSWORD renseignes => authentification + STARTTLS.
# SMTP_USER / SMTP_PASSWORD absents => connexion simple, sans TLS.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Expediteur applique a tous les envois (jamais parametrable par appel).
# Format Mailbox : "Nom <adresse@domaine>" ou "adresse@domaine".
MAIL_FROM=

# Authentification inter-services (header x-internal-secret)
# Min 32 octets UTF-8. Le service refuse de demarrer si absent ou trop court (fail-fast).
INTERNAL_API_SECRET=

# Rate-limit global des envois (POST /v1/send), en requetes par minute (fenetre fixe).
# Absent => defaut 60. Valeur invalide ou 0 => refus de demarrer.
RATE_LIMIT_PER_MINUTE=60
