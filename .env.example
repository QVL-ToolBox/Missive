# Missive - configuration d'environnement (placeholders, jamais de secret reel commite)

# Serveur HTTP
PORT=8184
BIND_ADDR=127.0.0.1

# Transport SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Authentification inter-services (header x-internal-secret)
# Min 32 caracteres. Jamais commite : renseigner dans .env local uniquement.
INTERNAL_API_SECRET=
